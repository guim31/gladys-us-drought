        },
        {
          "value": "5",
          "label": {
            "en": "5% of the county",
            "fr": "5 % du comté",
            "de": "5 % des Countys",
            "es": "5 % del condado"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10% of the county",
            "fr": "10 % du comté",
            "de": "10 % des Countys",
            "es": "10 % del condado"
          }
        },
        {
          "value": "25",
          "label": {
            "en": "25% of the county",
            "fr": "25 % du comté",
            "de": "25 % des Countys",
            "es": "25 % del condado"
          }
        },
        {
          "value": "50",
